  "monitoring_policy": {
    "_purpose": "Change intelligence for triaging crawler/monitor findings before re-pinning sources.",
    "primary_vs_secondary": {
      "primary": "Authoritative publisher (NIST CSRC, DISA, FedRAMP, HHS, AICPA, ISO, CSA, HITRUST). A change is actionable only when confirmed here.",
      "secondary": "Aggregators/news. Discovery only — never the sole basis for a re-pin."
    },
    "confidence_scoring": {
      "0.9": "Primary source, >=2 independent signals changed (size + last-modified, or new version tag)",
      "0.7": "Primary source, single signal changed",
      "0.4": "Secondary source or discovery-only signal"
    },
    "recency_window_days": 730,
    "never_auto_apply": "Source files are NEVER auto-downloaded into canonical-sources/. A human verifies the change on the primary source, then re-pins source_manifest.json and rebuilds the catalog.",
    "robots_policy": "Respect robots.txt. One honest User-Agent. Honor Retry-After/RateLimit-Reset. Back off, never bypass. No CAPTCHA bypass, no JS-evasion."
  },
