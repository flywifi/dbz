{
  "_schema": "fetch_schedule/1.0",
  "_purpose": "Weekly keep-current rotation (phase 51). Each slot is one cron in one workflow; the cron string that fired (github.event.schedule) selects the slot, so a delayed run still runs its own slot. mode 'pr' jobs may change canonical files and are proposed as one pull request per slot; mode 'report' jobs never write the repository and are summarised in the weekly digest with a commit suggestion. requests_measured is the live ledger of a dry run (date and probe recorded); tools/fetch_census.py --check fails when a day's planned requests to a host exceed its run_cap. Status 'not_scheduled' records a loader that cannot be automated, with the measured reason. Written only via tools/registry_io.py.",
  "timezone": "UTC",
  "volatile_keys": [
    "_as_of_date",
    "_fetched_at",
    "fetched_at",
    "generated_at",
    "retrieved_at",
    "checked_at",
    "_generated_at"
  ],
  "slots": {
    "mon-standards-check": {
      "cron": "17 6 * * 1",
      "workflow": "standards-watch.yml",
      "jobs": [
        "standards-check"
      ],
      "builds": "always"
    },
    "tue-regulatory": {
      "cron": "41 14 * * 2",
      "workflow": "weekly-refresh.yml",
      "jobs": [
        "fr-watcher",
        "ecfr-45-164",
        "ecfr-32-170",
        "eurlex"
      ],
      "builds": "when_changed"
    },
    "wed-vulnerability": {
      "cron": "47 14 * * 3",
      "workflow": "weekly-refresh.yml",
      "jobs": [
        "kev",
        "nvd-7d"
      ],
      "builds": "when_changed"
    },
    "thu-dod-mitre": {
      "cron": "53 14 * * 4",
      "workflow": "weekly-refresh.yml",
      "jobs": [
        "attack",
        "stig-library",
        "horizon-check"
      ],
      "builds": "when_changed"
    }
  },
