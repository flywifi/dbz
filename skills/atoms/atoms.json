{
  "schema_version": "1.0",
  "repo": "dbz",
  "atoms": [
    {
      "id": "compliance-crosswalk",
      "label": "Compliance Crosswalk",
      "version": "1.0",
      "path": "skills/atoms/compliance-crosswalk",
      "script": "cross-mapping/engine/overlap_calculator.py",
      "input_schema": {
        "normalized_controls": "array — list of {control_id, title, framework} objects",
        "target_framework": "string — framework_id to cross-map to (e.g. 'nist-800-53')"
      },
      "output_schema": {
        "crosswalk": "array — [{source_control, target_control, relationship_type}]",
        "gaps": "array — [{control_id, reason}] controls with no mapping",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "crosswalk",
        "nist",
        "er",
        "mapping"
      ],
      "export": {
        "name": "compliance_crosswalk",
        "description": "Cross-map a set of normalized controls onto a target framework, returning matched pairs plus the gaps with no mapping.",
        "invocation": "overlap_calculator.py (normalized_controls, target_framework)"
      }
    },
    {
      "id": "gap-analysis",
      "label": "Gap Analysis",
      "version": "1.0",
      "path": "skills/atoms/gap-analysis",
      "script": "cross-mapping/engine/overlap_calculator.py",
      "input_schema": {
        "crosswalked": "object — output of compliance-crosswalk atom",
        "framework_id": "string — target framework to check coverage against"
      },
      "output_schema": {
        "gaps": "array — [{control_id, family, title, severity}] uncovered controls",
        "coverage_pct": "number — percentage of controls covered",
        "db_built_at": "string — ISO timestamp when grc.db was last built",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "gap",
        "coverage",
        "nist",
        "audit"
      ],
      "export": {
        "name": "gap_analysis",
        "description": "Given a crosswalk, report the uncovered controls and the coverage percentage against a target framework.",
        "invocation": "overlap_calculator.py gap mode (crosswalked, framework_id)"
      }
    },
    {
      "id": "overlap-query",
      "label": "Framework Overlap Query",
      "version": "1.0",
      "path": "skills/atoms/overlap-query",
      "script": "cross-mapping/engine/er_overlap.py",
      "input_schema": {
        "framework_a": "string — first framework_id (e.g. 'soc-2')",
        "framework_b": "string — second framework_id (e.g. 'iso-27001')",
        "overlay": "string? — optional context overlay name(s) (stamps the result; single-pair queries suppress nothing)"
      },
      "output_schema": {
        "jaccard": "number — |A∩B|/|A∪B| overlap coefficient",
        "a_covers_b_pct": "number — % of B controls covered by A",
        "b_covers_a_pct": "number — % of A controls covered by B",
        "shared_controls": "array — control IDs in both frameworks"
      },
      "tags": [
        "overlap",
        "jaccard",
        "er",
        "shared-audit-work"
      ],
      "export": {
        "name": "framework_overlap",
        "description": "Compute the shared-audit-work overlap (Jaccard + directional coverage) between two compliance frameworks on the 800-53 spine.",
        "invocation": "dbz_query.py overlap --framework-a {framework_a} --framework-b {framework_b}"
      }
    },
    {
      "id": "framework-update-check",
      "label": "Framework Update Check",
      "version": "1.0",
      "path": "skills/atoms/framework-update-check",
      "script": "cross-mapping/engine/framework_monitor.py",
      "input_schema": {
        "framework_id": "string — ID from feed_registry.json"
      },
      "output_schema": {
        "framework_id": "string",
        "current_version": "string — version in feed_registry",
        "latest_detected": "string — version detected from crawl",
        "signal_type": "string — what signal triggered detection",
        "changed": "boolean — true if latest_detected != current_version",
        "notes": "string — optional context (e.g. 'retired')"
      },
      "tags": [
        "monitoring",
        "feed",
        "version",
        "registry"
      ]
    },
    {
      "id": "control-search",
      "label": "Control Search",
      "version": "1.0",
      "path": "skills/atoms/control-search",
      "script": "cross-mapping/engine/dbz_query.py",
      "input_schema": {
        "query": "string — keyword or phrase to search",
        "family": "string? — optional NIST family filter (e.g. 'AC', 'SC')",
        "max_results": "integer? — default 20"
      },
      "output_schema": {
        "controls": "array — [{id, title, family, text}]",
        "count": "integer"
      },
      "tags": [
        "search",
        "nist",
        "controls",
        "query"
      ],
      "export": {
        "name": "control_search",
        "description": "Full-text search across the 800-53 control catalog, optionally scoped to a NIST family.",
        "invocation": "dbz_query.py search --keyword {query} [--family {family}]"
      }
    },
    {
      "id": "control-scope",
      "label": "Control Scope Lookup",
      "version": "1.0",
      "path": "skills/atoms/control-scope",
      "script": "cross-mapping/engine/dbz_query.py",
      "input_schema": {
        "framework_id": "string — framework ID from feed_registry (e.g. 'fedramp-moderate')"
      },
      "output_schema": {
        "framework_id": "string",
        "controls": "array — [{id, title, family, baseline}]",
        "count": "integer"
      },
      "tags": [
        "scope",
        "baseline",
        "fedramp",
        "nist",
        "query"
      ]
    },
    {
      "id": "kev-lookup",
      "label": "KEV Vulnerability Lookup",
      "version": "1.0",
      "path": "skills/atoms/kev-lookup",
      "script": "cross-mapping/engine/dbz_query.py",
      "input_schema": {
        "cve_id": "string — CVE identifier (e.g. 'CVE-2021-44228')"
      },
      "output_schema": {
        "cve_id": "string",
        "date_added": "string — ISO date added to KEV",
        "vulnerability_name": "string",
        "affected_product": "string",
        "nist_families": "array — NIST 800-53 control families relevant to this CVE",
        "in_kev": "boolean"
      },
      "tags": [
        "kev",
        "cve",
        "vulnerability",
        "cisa",
        "query"
      ]
    },
    {
      "id": "cfr-lookup",
      "label": "CFR Section Lookup",
      "version": "1.0",
      "path": "skills/atoms/cfr-lookup",
      "script": "cross-mapping/engine/dbz_query.py",
      "input_schema": {
        "part": "string — CFR part in '45-CFR-164' format",
        "section": "string? — optional section number (e.g. '164.308')"
      },
      "output_schema": {
        "part": "string",
        "sections": "array — [{section_id, title, text, nist_families}]",
        "count": "integer"
      },
      "tags": [
        "cfr",
        "hipaa",
        "glba",
        "regulatory",
        "query"
      ],
      "export": {
        "name": "cfr_lookup",
        "description": "Look up a CFR part or section with its text and mapped NIST families.",
        "invocation": "dbz_query.py cfr --part {part} [--section {section}]"
      }
    },
    {
      "id": "attack-mapper",
      "label": "ATT&CK Technique Mapper",
      "version": "1.0",
      "path": "skills/atoms/attack-mapper",
      "script": "cross-mapping/engine/dbz_query.py",
      "input_schema": {
        "technique_id": "string — MITRE ATT&CK technique ID (e.g. 'T1078')"
      },
      "output_schema": {
        "technique_id": "string",
        "name": "string",
        "tactics": "array — MITRE tactic names",
        "nist_controls": "array — mapped NIST 800-53 control IDs"
      },
      "tags": [
        "mitre",
        "attack",
        "technique",
        "nist-mapping",
        "query"
      ]
    },
    {
      "id": "changelog-query",
      "label": "Framework Changelog Query",
      "version": "1.0",
      "path": "skills/atoms/changelog-query",
      "script": "cross-mapping/engine/dbz_query.py",
      "input_schema": {
        "framework_id": "string? — optional filter by framework",
        "since": "string? — optional ISO date filter"
      },
      "output_schema": {
        "entries": "array — [{framework_id, change_type, old_version, new_version, changed_at, summary}]",
        "count": "integer"
      },
      "tags": [
        "changelog",
        "version",
        "history",
        "query"
      ]
    },
    {
      "id": "edgar-breach-search",
      "label": "SEC EDGAR Breach Search",
      "version": "1.0",
      "path": "skills/atoms/edgar-breach-search",
      "script": "cross-mapping/engine/dbz_query.py",
      "input_schema": {
        "incident_type": "string? — ransomware | breach | unauthorized_access | disruption",
        "company": "string? — partial company name match",
        "since": "string? — ISO date YYYY-MM-DD; filter by disclosure date",
        "limit": "integer? — default 20"
      },
      "output_schema": {
        "incidents": "array — [{accession_no, company_name, cik, incident_date, disclosure_date, incident_type, nist_families, filing_url}]",
        "count": "integer",
        "db_built_at": "string",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "edgar",
        "sec",
        "breach",
        "incident",
        "nist",
        "query"
      ]
    },
    {
      "id": "overlap-oracle-validator",
      "label": "Overlap Oracle Validator",
      "version": "1.0",
      "path": "skills/atoms/overlap-oracle-validator",
      "script": "cross-mapping/engine/er_overlap.py",
      "input_schema": {
        "framework_a": "string — e.g. SOC2, ISO27001, HIPAA",
        "framework_b": "string — e.g. ISO27001, HITRUST, GDPR",
        "check_oracle": "boolean? — default false; validate against combination CSV oracle"
      },
      "output_schema": {
        "framework_a": "string",
        "framework_b": "string",
        "jaccard": "number — 0.0–1.0",
        "a_covers_b_pct": "number — 0.0–100.0",
        "b_covers_a_pct": "number — 0.0–100.0",
        "oracle_delta": "number or null — deviation from oracle CSV value",
        "oracle_status": "string — pass | fail | skipped",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "overlap",
        "jaccard",
        "oracle",
        "er",
        "validation"
      ]
    },
    {
      "id": "ecfr-monitor",
      "label": "eCFR Part Monitor",
      "version": "1.0",
      "path": "skills/atoms/ecfr-monitor",
      "script": "cross-mapping/engine/ecfr_loader.py",
      "input_schema": {
        "title": "integer — CFR title number (e.g. 45)",
        "part": "integer — CFR part number (e.g. 164)",
        "subpart": "string? — subpart letter (e.g. 'C')",
        "since_date": "string? — ISO date YYYY-MM-DD; detect changes since this date"
      },
      "output_schema": {
        "title": "integer",
        "part": "integer",
        "subpart": "string or null",
        "as_of_date": "string — YYYY-MM-DD from eCFR versioner API",
        "section_count": "integer",
        "changed": "boolean — true if as_of_date > since_date",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "cfr",
        "ecfr",
        "regulatory",
        "hipaa",
        "glba",
        "monitor"
      ]
    },
    {
      "id": "feed-poller",
      "label": "Framework Feed Poller",
      "version": "1.0",
      "path": "skills/atoms/feed-poller",
      "script": "cross-mapping/engine/framework_monitor.py",
      "input_schema": {
        "framework_id": "string — ID from feed_registry.json (e.g. 'nist-800-53', 'hitrust')"
      },
      "output_schema": {
        "framework_id": "string",
        "label": "string",
        "current_version": "string",
        "latest_detected": "string or null",
        "check_strategy": "string — github_release | poll_landing | rss_feed",
        "version_signal": "string",
        "changed": "boolean",
        "draft_status": "string — none | draft | retired",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "monitoring",
        "feed",
        "version",
        "registry",
        "poll"
      ]
    },
    {
      "id": "task-decompose",
      "label": "Task Decompose",
      "version": "1.0",
      "path": "skills/atoms/task-decompose",
      "script": "skills/multi-agent-orchestrator/scripts/frontier.py",
      "input_schema": {
        "task": "string — the work to decompose",
        "corpus_hint": "string? — optional description of the material to size the partition",
        "max_scopes": "integer? — cap on first-wave scopes; default = concurrency cap (16)"
      },
      "output_schema": {
        "mode": "string — read-fanout | mutate | external (from routing table)",
        "scopes": "array — [{scope, rationale}] non-overlapping first-wave assignments",
        "stop_conditions": "object — {k_dry, depth_cap, size_cap} resolved for this mode",
        "minority_report": "object or null — mode ambiguity recorded here",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "orchestration",
        "decompose",
        "fan-out",
        "planning"
      ]
    },
    {
      "id": "envelope-validate",
      "label": "Envelope Validate",
      "version": "1.0",
      "path": "skills/atoms/envelope-validate",
      "script": "skills/multi-agent-orchestrator/scripts/validate_envelope.py",
      "input_schema": {
        "envelope": "object — a single agent return to check",
        "schema_path": "string? — default skills/shared/orchestration-envelope.schema.json"
      },
      "output_schema": {
        "valid": "boolean",
        "violations": "array — [{path, message}] empty when valid",
        "task_id": "string or null — echoed from the envelope",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "orchestration",
        "validation",
        "drift-guard",
        "schema"
      ]
    },
    {
      "id": "findings-consolidate",
      "label": "Findings Consolidate",
      "version": "1.0",
      "path": "skills/atoms/findings-consolidate",
      "script": "skills/multi-agent-orchestrator/scripts/consolidate.py",
      "input_schema": {
        "run_id": "string — identifier for this orchestration run",
        "envelopes": "array — validated envelopes conforming to orchestration-envelope.schema.json",
        "stop_condition": "string? — the frontier stop condition that ended the run"
      },
      "output_schema": {
        "run_id": "string",
        "coverage": "object — {state, agents_total, agents_complete, agents_partial, agents_blocked, sources_read, stop_condition}",
        "findings": "array — [{key, status, value, provenance, confidence}] sorted by key",
        "residual_frontier": "array — union of open leads at stop time",
        "minority_report": "object or null — rolled-up conflicts / failed_to_merge / residual_uncertainty",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "orchestration",
        "consolidate",
        "merge",
        "deterministic"
      ]
    },
    {
      "id": "frontier-expand",
      "label": "Frontier Expand",
      "version": "1.0",
      "path": "skills/atoms/frontier-expand",
      "script": "skills/multi-agent-orchestrator/scripts/frontier.py",
      "input_schema": {
        "envelopes": "array — this wave's validated envelopes",
        "seen": "array — scope signatures already dispatched",
        "wave": "integer — current wave number",
        "stop_conditions": "object — {k_dry, depth_cap, size_cap}",
        "agents_so_far": "integer — total agents dispatched"
      },
      "output_schema": {
        "next_scopes": "array — [{scope, reason, parent_task_id}] deduped leads (empty if none)",
        "saturated": "boolean — true when no new leads remain",
        "stop_condition": "string or null — saturated | depth_cap_reached | size_cap_reached",
        "seen_out": "array — updated scope-signature set",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "orchestration",
        "frontier",
        "recursion",
        "fan-out"
      ]
    },
    {
      "id": "finding-verify",
      "label": "Finding Verify (adversarial)",
      "version": "1.0",
      "path": "skills/atoms/finding-verify",
      "script": "skills/multi-agent-orchestrator/scripts/verify.py",
      "input_schema": {
        "finding": "object — {key, value, provenance, confidence} under scrutiny",
        "why_material": "string — why this finding warrants verification",
        "skeptic_votes": "object — {refuting, confirming, unable} from independent skeptic agents"
      },
      "output_schema": {
        "key": "string",
        "verdict": "string — confirmed | refuted | unverified",
        "refuting_votes": "integer",
        "confirming_votes": "integer",
        "unable_votes": "integer",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "orchestration",
        "verify",
        "adversarial",
        "skeptic"
      ]
    },
    {
      "id": "wave-judge",
      "label": "Wave Judge (rubric stop signal)",
      "version": "1.0",
      "path": "skills/atoms/wave-judge",
      "script": "skills/multi-agent-orchestrator/scripts/judge.py",
      "input_schema": {
        "coverage": "number 0.0-1.0 — how much of the intended scope the wave reached",
        "consistency": "number 0.0-1.0 — freedom from unresolved conflicts",
        "provenance": "number 0.0-1.0 — how well findings are sourced",
        "saturation": "number 0.0-1.0 — confidence the frontier is exhausted"
      },
      "output_schema": {
        "composite": "number 0.0-1.0 — weighted rubric score",
        "recommendation": "string — stop | continue",
        "weakest_dimension": "string",
        "dimension_scores": "object",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "orchestration",
        "judge",
        "rubric",
        "stop-signal"
      ]
    },
    {
      "id": "instruction-audit",
      "label": "Instruction Audit (contradiction/drift)",
      "version": "1.0",
      "path": "skills/atoms/instruction-audit",
      "script": "skills/health-auditor/scripts/instruction_blocks.py",
      "input_schema": {
        "skill_dir": "string — path to the skill/atom directory to audit",
        "num_skeptics": "integer? — independent verifiers per flagged contradiction (default 3)"
      },
      "output_schema": {
        "skill_dir": "string",
        "contradictions": "array — [{rule, severity, a_section, b_section, summary, provenance}] confirmed only",
        "block_histogram": "object — class -> count",
        "pairs_checked": "integer",
        "minority_report": "object or null",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "health",
        "instruction",
        "contradiction",
        "adversarial",
        "arbiter"
      ]
    },
    {
      "id": "master-crosswalk",
      "label": "Master Mapping Surface",
      "version": "1.0",
      "path": "skills/atoms/master-crosswalk",
      "script": "cross-mapping/engine/master_surface.py",
      "input_schema": {
        "framework_a": "string — first framework (pair/scope modes; alias ok, e.g. 'SOC 2')",
        "framework_b": "string — second framework (pair mode)",
        "framework": "string — framework of --control (control mode)",
        "control": "string — one native id (control mode, e.g. 'CC6.1', '164.312(a)(1)')",
        "scope_fedramp": "string — low|moderate|high (audit-scope mode)",
        "min_tier": "string — owner_direct|nist_stated|hub|bundled|consensus|production_aggregate",
        "evidence_state": "string? — optional filter: oracle_confirmed|cross_validated|columns_aligned|asserted_by_source (corroboration ladder)",
        "overlay": "string? — optional context overlay name(s), comma-separated (presentation filter; suppression always disclosed)"
      },
      "output_schema": {
        "rows": "array — master_mappings rows: fw/native pair, relationship, tier, provenance, confidence, votes, production_support, shared_anchors, corroboration (minority report), source_ref",
        "summary": "string — mode-specific header (audit-scope mode reports n-of-m advisory coverage)",
        "human_review_required": "boolean — always true"
      },
      "tags": [
        "master-mapping",
        "crosswalk",
        "tier-arbitration",
        "minority-report",
        "audit-scope"
      ],
      "export": {
        "name": "master_crosswalk",
        "description": "Query the unified master mapping surface for any framework-to-any-framework relationships, tier-arbitrated with corroboration; supports pair, control, and audit-scope modes.",
        "invocation": "dbz_query.py master --framework-a {framework_a} --framework-b {framework_b} (or --framework/--control, or --scope-fedramp)"
      }
    }
  ]
}
