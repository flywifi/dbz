{
  "atom": "envelope-validate",
  "version": "1.0",
  "cases": [
    {
      "id": "pass-01",
      "label": "Well-formed envelope — valid with no violations",
      "input": {
        "envelope": {
          "task_id": "demo.w1.01",
          "parent_task_id": null,
          "scope": "NIST PM family — role extraction",
          "mode": "read-fanout",
          "status": "complete",
          "findings": [
            {"key": "AO", "value": "Authorizing Official", "provenance": "NIST_800_53_PM.json:CA-6", "confidence": "high"}
          ],
          "residual_frontier": [],
          "provenance": {"sources_read": ["NIST_800_53_PM.json"], "method": "grep + read"},
          "confidence": "high",
          "minority_report": null,
          "human_review_required": true,
          "metrics": {"items_found": 1, "duration_ms": 1200}
        }
      },
      "expected_output": {"valid": true, "violations": {"$maxItems": 0}, "human_review_required": true},
      "expect_pass": true,
      "note": "A conformant envelope passes with zero violations"
    },
    {
      "id": "fail-01",
      "label": "Missing residual_frontier — fails with a pointed violation",
      "input": {
        "envelope": {
          "task_id": "demo.w1.02",
          "scope": "NIST CA family",
          "mode": "read-fanout",
          "status": "complete",
          "findings": [],
          "provenance": {"sources_read": [], "method": "read"},
          "confidence": "medium",
          "minority_report": null,
          "human_review_required": true,
          "metrics": {"items_found": 0}
        }
      },
      "expected_output": {"valid": false, "violations": {"$minItems": 1}},
      "expect_pass": true,
      "note": "residual_frontier is required — its absence must fail, not default to []"
    },
    {
      "id": "edge-01",
      "label": "human_review_required false — fails const:true enforcement",
      "input": {
        "envelope": {
          "task_id": "demo.w1.03",
          "parent_task_id": null,
          "scope": "NIST IA family",
          "mode": "read-fanout",
          "status": "complete",
          "findings": [],
          "residual_frontier": [],
          "provenance": {"sources_read": ["NIST_800_53_IA.json"], "method": "read"},
          "confidence": "high",
          "minority_report": null,
          "human_review_required": false,
          "metrics": {"items_found": 0}
        }
      },
      "expected_output": {"valid": false, "violations": {"$minItems": 1}},
      "expect_pass": true,
      "note": "human_review_required is pinned to const true; false is drift and must fail"
    }
  ]
}
