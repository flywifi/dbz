           "residual_frontier": [], "provenance": {"sources_read": ["OLIR"], "method": "read"},
           "confidence": "high", "minority_report": null, "human_review_required": true, "metrics": {"items_found": 1}},
          {"task_id": "demo.w1.02", "parent_task_id": null, "scope": "ER", "mode": "read-fanout", "status": "complete",
           "findings": [{"key": "AC-2/SOC-CC6.1", "value": "Equal", "provenance": "ER-crosswalk", "confidence": "high"}],
