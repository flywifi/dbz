{
  "atom": "findings-consolidate",
  "version": "1.0",
  "cases": [
    {
      "id": "pass-01",
      "label": "Two agents agree on a key — single merged finding, coverage complete",
      "input": {
        "run_id": "demo",
        "envelopes": [
          {"task_id": "demo.w1.01", "parent_task_id": null, "scope": "PM", "mode": "read-fanout", "status": "complete",
           "findings": [{"key": "AO", "value": "Authorizing Official", "provenance": "PM.json", "confidence": "high"}],
           "residual_frontier": [], "provenance": {"sources_read": ["PM.json"], "method": "read"},
           "confidence": "high", "minority_report": null, "human_review_required": true, "metrics": {"items_found": 1}},
          {"task_id": "demo.w1.02", "parent_task_id": null, "scope": "CA", "mode": "read-fanout", "status": "complete",
           "findings": [{"key": "AO", "value": "Authorizing Official", "provenance": "CA.json", "confidence": "medium"}],
           "residual_frontier": [], "provenance": {"sources_read": ["CA.json"], "method": "read"},
           "confidence": "high", "minority_report": null, "human_review_required": true, "metrics": {"items_found": 1}}
        ]
      },
      "expected_output": {
        "findings": [{"key": "AO", "status": "merged", "confidence": "medium"}],
        "coverage": {"state": "complete"},
        "human_review_required": true
      },
      "expect_pass": true,
      "note": "Agreement merges to one finding; confidence floored to medium (lowest of high/medium)"
    },
    {
