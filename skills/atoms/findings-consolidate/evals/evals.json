      "expect_pass": true,
      "note": "Superset vs Equal must be preserved as a conflict, never blended into one value"
    },
    {
      "id": "edge-01",
      "label": "One blocked agent — coverage partial, gap tied to the blocked scope",
      "input": {
        "run_id": "demo",
        "envelopes": [
          {"task_id": "demo.w1.01", "parent_task_id": null, "scope": "PM", "mode": "read-fanout", "status": "complete",
           "findings": [{"key": "AO", "value": "Authorizing Official", "provenance": "PM.json", "confidence": "high"}],
           "residual_frontier": [], "provenance": {"sources_read": ["PM.json"], "method": "read"},
