{
  "atom": "overlap-query",
  "version": "2.0",
  "cases": [
    {
      "id": "pass-01",
      "label": "SOC 2 × ISO 27001 returns a spine basis (cci/subpart) with a plausible overlap",
      "input": {
        "framework_a": "SOC 2",
        "framework_b": "ISO 27001/2 (2022)"
      },
      "expected_output": {
        "basis_in": ["cci", "subpart"],
        "overlap_min": 40.0,
        "overlap_max": 70.0,
        "needs_confirmation": true
      },
      "expect_pass": true,
      "notes": "Spine-anchored (hub-mediated on the SOC 2 side); commercial pairs carry needs_confirmation"
    },
    {
      "id": "fail-01",
      "label": "Unknown framework name — input error with the name and known_frameworks",
      "input": {
        "framework_a": "unknown-framework-xyz",
        "framework_b": "ISO 27001/2 (2022)"
      },
      "expected_error": "unknown-framework-xyz",
      "expect_pass": false
    },
    {
      "id": "edge-01",
      "label": "Framework mapped to itself — overlap must be 100%",
      "input": {
        "framework_a": "SOC 2",
        "framework_b": "SOC 2"
      },
      "expected_output": {
        "overlap_pct": 100.0,
        "a_covers_b_pct": 100.0,
        "b_covers_a_pct": 100.0
      },
      "expect_pass": true
    },
    {
      "id": "edge-02",
      "label": "Unbridged pair never errors — returns basis:none, overlap 0.0, exit 0",
      "input": {
        "framework_a": "PCI DSS v4.0",
        "framework_b": "GDPR"
      },
      "expected_output": {
        "basis": "none",
        "overlap_pct": 0.0
      },
      "expect_pass": true,
      "notes": "Never-error contract: no spine path and no shared ER ids -> a real zero, not an exception"
    }
  ]
}
