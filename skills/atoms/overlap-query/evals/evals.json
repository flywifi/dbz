{
  "atom": "overlap-query",
  "version": "1.0",
  "cases": [
    {
      "id": "pass-01",
      "label": "SOC 2 × ISO 27001 Jaccard must be in oracle range [0.78, 0.82]",
      "input": {
        "framework_a": "soc-2",
        "framework_b": "iso-27001"
      },
      "expected_output": {
        "jaccard_min": 0.78,
        "jaccard_max": 0.82
      },
      "expect_pass": true,
      "notes": "Regression oracle: SOC 2 T2 & ISO 27001.csv is the ground-truth overlap data"
    },
    {
      "id": "fail-01",
      "label": "Unknown framework_id — must error with framework_id in message",
      "input": {
        "framework_a": "unknown-framework-xyz",
        "framework_b": "iso-27001"
      },
      "expected_error": "unknown-framework-xyz",
      "expect_pass": false
    },
    {
      "id": "edge-01",
      "label": "Framework mapped to itself — Jaccard must be 1.0",
      "input": {
        "framework_a": "soc-2",
        "framework_b": "soc-2"
      },
      "expected_output": {
        "jaccard": 1.0,
        "a_covers_b_pct": 100.0,
        "b_covers_a_pct": 100.0
      },
      "expect_pass": true
    }
  ]
}
