{
  "_purpose": "Independent ground truth for run_golden.py — authored BY HAND from the broken/clean fixtures, not generated by the auditor. A reviewer can open each fixture and confirm the expected findings without running anything. run_golden.py asserts the real detectors reproduce them; final_sha256 pins byte-for-byte determinism.",

  "broken": {
    "dangling_ref.md": {
      "detector": "backtick_refs",
      "expect": [{"severity": "blocking", "contains": "ghost-atom"}]
    },
    "forbidden.md": {
      "detector": "forbidden_tokens",
      "expect": [{"severity": "blocking", "contains": "forbidden token 'TODO'"}]
    },
    "bad_evals.json": {
      "detector": "evals_shape",
      "expect": [
        {"severity": "blocking", "contains": "need >=3"},
        {"severity": "warning", "contains": "no expected outcome"}
      ]
    },
    "bad_data.json": {
      "detector": "vocab",
      "expect": [
        {"severity": "blocking", "contains": "framework name not in controlled vocab: 'ISO 27001'"},
        {"severity": "blocking", "contains": "relationship_type not allowed: 'BOGUS'"},
        {"severity": "blocking", "contains": "malformed CCI id: 'CCI-12'"}
      ]
    },
    "bad_registry.json": {
      "detector": "registry_scripts",
      "expect": [{"severity": "blocking", "contains": "DOES_NOT_EXIST.py"}]
    },
    "ghost_workflow.json": {
      "detector": "workflow",
      "expect": [
        {"severity": "blocking", "contains": "unknown atom/skill 'nonexistent-atom'"},
        {"severity": "blocking", "contains": "duplicate workflow step id 's1'"}
      ]
    },
    "dangling_dir.md": {
      "detector": "backtick_refs",
      "expect": [{"severity": "warning", "contains": "canonical-sources/does-not-exist/"}]
    },
    "space_filename.md": {
      "detector": "backtick_refs",
      "expect": [{"severity": "warning", "contains": "Nonexistent File.csv"}]
    }
  },

  "clean": {
    "clean_ref.md": {"detectors": ["backtick_refs", "forbidden_tokens"], "expect_zero": true},
    "clean_data.json": {"detector": "vocab", "expect_zero": true}
  },

  "negative_control": {
    "_note": "dangling_ref.md with the ghost path swapped for a real one must yield ZERO — proves the detector reacts to the real defect, not to the fixture merely existing.",
    "file": "dangling_ref.md",
    "replace": "skills/atoms/ghost-atom/SKILL.md",
    "with": "skills/atoms/feed-poller/SKILL.md"
  },

  "final_sha256": "0e6db2fa9b09e28f1c835486713c499c39a78446e2ddb1385239e77ba011025e"
}
